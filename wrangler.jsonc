{
  // Cloudflare Workers config (migrated from Deno Deploy).
  // Docs: https://developers.cloudflare.com/workers/static-assets/
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "worker",
  "main": "./src/index.ts",
  "compatibility_date": "2026-10-09",
  "assets": {
    // Served as-is (no Worker invocation) unless matched by run_worker_first.
    "directory": "./static",
    "binding": "ASSETS",
    // html_handling: default ("auto-trailing-slash"); /foo.html redirects to
    // /foo and "/" serves index.html.
    // Only these paths run the Worker code (dynamic handlers).
    "run_worker_first": ["/api/*"]
  }
}
